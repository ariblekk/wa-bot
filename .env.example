# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_READ_TIMEOUT_SECONDS=15
APP_WRITE_TIMEOUT_SECONDS=15
APP_SHUTDOWN_TIMEOUT_SECONDS=10
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

# GoWA webhook verification
WEBHOOK_PATH=/webhook/gowa
WEBHOOK_SECRET=change-this-to-a-long-random-secret

# OpenAI-compatible Chat Completions API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_COMPLETIONS_PATH=/chat/completions
OPENAI_MODEL=gpt-4o-mini
OPENAI_SYSTEM_PROMPT_FILE=./prompts/system.txt
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_TOKENS=0

# Conversation memory
CHAT_MEMORY_ENABLED=false
CHAT_MEMORY_MAX_MESSAGES=20
CHAT_MEMORY_TTL_HOURS=24
POSTGRES_DSN=postgresql://user:password@127.0.0.1:5432/wa_chatbot?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2

# GoWA
GOWA_BASE_URL=http://localhost:3000
GOWA_SEND_MESSAGE_PATH=/send/message
GOWA_READ_MESSAGE_PATH=/message/{message_id}/read
GOWA_CHAT_PRESENCE_PATH=/send/chat-presence
GOWA_DOWNLOAD_MEDIA_PATH=/message/{message_id}/download
GOWA_MEDIA_TIMEOUT_SECONDS=30
GOWA_API_KEY=
GOWA_BASIC_AUTH=
GOWA_DEVICE_ID=
GOWA_TIMEOUT_SECONDS=30

# Behavior
ALLOW_GROUP_MESSAGES=false
HUMANIZE_ENABLED=true
HUMANIZE_MIN_TYPING_SECONDS=2
IMAGE_ENABLED=true
IMAGE_MAX_BYTES=5242880

# MeTube: leave disabled unless explicitly configured
METUBE_ENABLED=false
METUBE_BASE_URL=
METUBE_API_KEY=
METUBE_ADD_PATH=/add
METUBE_HISTORY_PATH=/history
METUBE_VIDEO_FILE_PATH=/download
METUBE_AUDIO_FILE_PATH=/audio_download
METUBE_VIDEO_QUALITY=720
METUBE_VIDEO_FORMAT=mp4
METUBE_VIDEO_CODEC=h264
METUBE_AUDIO_FORMAT=mp3
METUBE_ALLOWED_HOSTS=
METUBE_AUDIO_ONLY_HOSTS=soundcloud.com,on.soundcloud.com,bandcamp.com,mixcloud.com,audiomack.com,podcastaddict.com,snipd.com,archive.org
METUBE_POLL_SECONDS=3
METUBE_WAIT_TIMEOUT_SECONDS=600
METUBE_REQUEST_TIMEOUT_SECONDS=20
METUBE_ADD_TIMEOUT_SECONDS=120
